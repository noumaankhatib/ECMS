# Copy to config.env (gitignored) and fill in. Contains no secrets.

# AWS CLI profile for the NEW account (see docs/AWS-SETUP.md step 4).
AWS_PROFILE=ecms
# Required. No default on purpose: pick a region close to your users, then keep it.
AWS_REGION=

PROJECT=ecms
STACK_NAME=ecms-prod

# Budget and alarm emails go here. Confirm the SNS subscription email AWS sends.
ALERT_EMAIL=

INSTANCE_TYPE=t3.small
ROOT_VOLUME_GIB=30
MONTHLY_BUDGET_USD=100

# Leave empty to serve over plain HTTP on the Elastic IP.
# Set to your domain only AFTER nginx has HTTPS (docs/AWS-SETUP.md, "Adding a domain").
DOMAIN=
