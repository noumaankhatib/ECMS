{
  "name": "ecms",
  "version": "0.1.0",
  "private": true,
  "description": "Engineering Consultancy Management System",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "bootstrap": "node scripts/setup.mjs",
    "bootstrap:dry": "node scripts/setup.mjs --dry-run",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty && pnpm --filter @ecms/web run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --build",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --build",
    "db:migrate": "prisma migrate dev --schema=apps/api/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=apps/api/prisma/schema.prisma",
    "db:status": "prisma migrate status --schema=apps/api/prisma/schema.prisma",
    "db:generate": "prisma generate --schema=apps/api/prisma/schema.prisma",
    "test": "pnpm -r --if-present run test",
    "e2e": "node scripts/e2e.mjs",
    "verify": "pnpm run check && pnpm run test",
    "dev": "node --watch apps/api/dist/main.js",
    "user:create": "node apps/api/dist/tools/create-user.js",
    "dev:web": "pnpm --filter @ecms/web run dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import-x": "^4.6.1",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
