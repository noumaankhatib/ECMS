# Copy to .env and fill in. Never commit .env.
# See docs/phase-1-plan.md

NODE_ENV=development

# Database — Postgres. Local values come from docker-compose.
# The app uses DB_APP_* credentials; migrations use DB_OWNER_* credentials.
# The owner role can alter schema; the app role deliberately cannot.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecms
DB_APP_USER=ecms_app
DB_APP_PASSWORD=change_me
DB_OWNER_USER=ecms_owner
DB_OWNER_PASSWORD=change_me
# Superuser — local dev only. Used only by db:migrate reset to re-apply grants after schema drop.
DB_SUPER_USER=postgres
DB_SUPER_PASSWORD=change_me

# Optional. Shown with their defaults so the knobs are discoverable.
PORT=3001
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
