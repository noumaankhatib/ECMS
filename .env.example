# Copy to .env and fill in. Never commit .env.
# See docs/phase-1-plan.md

NODE_ENV=development

# Database — Postgres. Local values come from docker-compose.
DATABASE_URL=postgresql://ecms_app:ecms_local_password@localhost:5432/ecms

# Migrations run as a separate, higher-privileged role than the application.
# The app role is deliberately unable to alter schema or edit audit history.
MIGRATION_DATABASE_URL=postgresql://ecms_owner:ecms_local_password@localhost:5432/ecms
